# Server
APP_PORT=8080

# External Auth Server
AUTH_SERVER_URL=http://localhost:8081

# Rate Limiting
RATE_LIMIT_ENABLED=true

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Microsoft Graph API — credenciais do Azure App Registration (client credentials flow)
# GRAPH_TENANT_ID: UUID do tenant — extraia da authority URL: https://login.microsoftonline.com/{TENANT_ID}
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=your-client-secret

# Migration Writer — tamanho do batch JDBC por execução de INSERT
WRITER_BATCH_SIZE=500

# Debug
JPA_SHOW_SQL=false

# ---------------------------------------------------------------------------
# Connection Registry — bancos de destino para migração
#
# Defina pares CONN_URL_{KEY} + CONN_NAME_{KEY} para cada banco.
# O KEY deve conter apenas letras maiúsculas, números e underscores.
# Os jobs armazenam somente o KEY — a URL nunca é persistida no SQLite.
#
# Conexões também podem ser registradas em runtime via POST /v1/connections
# (úteis para testes pontuais — são perdidas ao reiniciar o servidor).
# ---------------------------------------------------------------------------

CONN_URL_MYSQL_PROD=jdbc:mysql://prod-host:3306/mydb?user=admin&password=secret
CONN_NAME_MYSQL_PROD=MySQL Produção

CONN_URL_MYSQL_DEV=jdbc:mysql://localhost:3306/mydb_dev?user=root&password=root
CONN_NAME_MYSQL_DEV=MySQL Desenvolvimento

CONN_URL_PG_PROD=jdbc:postgresql://prod-host:5432/analytics
CONN_NAME_PG_PROD=PostgreSQL Produção

CONN_URL_PG_DEV=jdbc:postgresql://localhost:5432/analytics_dev
CONN_NAME_PG_DEV=PostgreSQL Desenvolvimento

CONN_URL_MONGO_PROD=mongodb://user:password@prod-host:27017/mydb
CONN_NAME_MONGO_PROD=MongoDB Produção
